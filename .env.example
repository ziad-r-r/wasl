DATABASE_URL=
# Leave DATABASE_URL empty to use embedded PostgreSQL (PGlite) in .data/
# Example for Docker Postgres:
# DATABASE_URL=postgres://wasl:wasl@localhost:5432/wasl

SESSION_SECRET=replace-with-a-long-random-string

# S3-compatible storage. Leave empty to store uploads in public/uploads.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE=

APP_URL=http://localhost:3000
